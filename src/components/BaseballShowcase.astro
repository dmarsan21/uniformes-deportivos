<script is:inline>
  (function initShowcaseVideos() {
    const videos = [
      document.getElementById('showcase-video-softbol'),
      document.getElementById('showcase-video-baseball')
    ].filter(Boolean);

    // Silencio en ambos videos
    videos.forEach((video) => {
      video.muted = true;
    });

    if ('IntersectionObserver' in window && videos.length > 0) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const vid = entry.target;
          if (entry.isIntersecting) {
            vid.play().catch(() => {});
          } else {
            vid.pause();
          }
        });
      }, { threshold: 0.2 });

      videos.forEach((vid) => videoObserver.observe(vid));
    }
  })();
</script>
