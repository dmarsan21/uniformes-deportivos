      <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37] animate-ping"></span>
      <span class="text-[#D4AF37] font-bold uppercase tracking-wider">Confección Diamante Pro</span>
    </div>
  </div>

  <!-- ======================================================= -->
  <!-- BLOQUE 1: VITRINA DE SOFTBOL PRO (VIDEO 1: softbol.mp4) -->
  <!-- ======================================================= -->
  <div class="mb-20 sm:mb-28 relative z-10">
    <!-- Sub-encabezado de sección 1 -->
    <div class="flex items-center gap-3 mb-6">
