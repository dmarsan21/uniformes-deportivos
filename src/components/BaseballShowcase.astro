    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- COLUMNA IZQUIERDA: VIDEO DE SOFTBOL -->
      <div class="reveal-on-scroll lg:col-span-5 flex flex-col items-center">
        <div 
          class="w-full aspect-[4/5] sm:aspect-square lg:aspect-[4/5] bg-zinc-950 border border-[#D4AF37]/30 rounded-3xl relative overflow-hidden flex flex-col items-center justify-center shadow-2xl group hover:border-[#D4AF37]/70 transition-all duration-500"
          data-tilt
        >
          <video
            id="showcase-video-softbol"
            class="baseball-showcase-video absolute inset-0 w-full h-full object-cover object-center"
