    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- COLUMNA IZQUIERDA: VIDEO DE BÉISBOL -->
      <div class="reveal-on-scroll lg:col-span-5 flex flex-col items-center">
