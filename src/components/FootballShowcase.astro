---
// src/components/FootballShowcase.astro
const WHATSAPP_URL = "https://wa.me/520000000000?text=" + encodeURIComponent("Hola Alpha Aurea, quiero cotizar uniformes de Fútbol Americano Combat Armor para mi equipo/liga.");

interface SpecificationItem {
  id: string;
  title: string;
  badge: string;
  description: string;
  icon: string;
  features: string[];
}

const specsCombatArmor: SpecificationItem[] = [
  {
    id: "jersey-combat-pro",
    title: "Jersey Armor Grid Combat",
    badge: "Grado Máximo Contacto",
    description: "Confección anatómica ceñida sobre coraza y hombreras, con hilos de filamento continuo para resistir tirones violentos.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    features: [
      "Malla Spandex Heavy 400g resistente a tirones",
      "Costura Flatlock cuádruple grado militar en hombros",
      "Cuello en V reforzado anti-deformación"
    ]
  },
  {
    id: "funda-integrated-pants",
    title: "Funda de Juego con Bolsas / Integrada",
    badge: "Protección Focalizada",
    description: "Funda elástica de compresión con bolsillos para tablas en muslos, caderas y rodillas, o sistema de pads integrados.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    features: [
      "Tejido de compresión muscular activa 4-Way Stretch",
      "Bolsas de alta tenacidad para pads protectores",
      "Cinturón túnel elástico con broches reforzados"
    ]
  },
  {
    id: "paneles-dry-tech",
    title: "Paneles Mesh de Ventilación",
    badge: "Evaporación Rápida",
    description: "Inserciones laterales y dorsales en micro-malla transpirable para liberar el exceso de calor bajo la coraza.",
    icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z",
    features: [
      "Respiración omnidireccional en zona costal y lumbar",
      "Tejido hidrofóbico anti-acumulación de sudor",
      "Tratamiento antibacteriano anti-olores"
    ]
  },
  {
    id: "personalizacion-completa",
    title: "Dorsales & Tipografía Oficial",
    badge: "Sublimación 205°C",
    description: "Números gigantes de alto contraste para visibilidad arbitral, nombres de jugador y logotipos sin límite de color.",
    icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
    features: [
      "Números frontales, dorsales y en hombreras (TV numbers)",
      "Placa de apellido personalizada incluida",
      "Cero deslavado // Fusión térmica molecular"
    ]
  }
];
---

<section id="americano-showcase" class="relative py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden">
  <!-- Glow decorativo de fondo: Oro + Rojo Carmesí 49ers -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#B30000]/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[#D4AF37]/15 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Header de disciplina general -->
  <div class="reveal-on-scroll flex flex-col md:flex-row md:items-end justify-between mb-14 sm:mb-16 gap-6 relative z-10">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#16161d] border border-[#D4AF37]/40 text-[#D4AF37] text-xs font-bold uppercase tracking-widest mb-4 shadow-[0_0_20px_rgba(212,175,55,0.15)]">
        <span class="w-2 h-2 rounded-full bg-[#B30000] animate-pulse"></span>
        <span>Línea Combat Armor 49 // Máximo Contacto</span>
      </div>
      <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white leading-tight">
        Fútbol Americano de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37] drop-shadow-[0_0_30px_rgba(212,175,55,0.4)]">Alto Impacto</span>
      </h2>
      <p class="text-neutral-300 mt-4 text-sm sm:text-base lg:text-lg leading-relaxed">
        Equipaciones blindadas contra tirones, colisiones y agarres bruscos. Confeccionadas con elastano pesado de 400g e hilos militares.
      </p>
    </div>

    <div class="hidden lg:flex items-center gap-2 text-xs font-mono text-neutral-400 bg-white/5 border border-[#D4AF37]/30 px-4 py-2.5 rounded-2xl backdrop-blur-md">
      <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37] animate-ping"></span>
      <span class="text-[#D4AF37] font-bold uppercase tracking-wider">Patrón Ceñido a Hombrera</span>
    </div>
  </div>

  <!-- Grid Principal de Vitrina: Video + Especificaciones -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
    <!-- COLUMNA IZQUIERDA: VIDEO CON CARGA INTELIGENTE Y ACCENT GOLD/RED -->
    <div class="reveal-on-scroll lg:col-span-5 flex flex-col items-center">
      <div 
        class="w-full aspect-[4/5] sm:aspect-square lg:aspect-[4/5] bg-zinc-950 border border-[#D4AF37]/30 rounded-3xl relative overflow-hidden flex flex-col items-center justify-center shadow-2xl group hover:border-[#D4AF37]/80 transition-all duration-500"
        data-tilt
      >
        <video
          id="showcase-video-americano"
          class="american-showcase-video absolute inset-0 w-full h-full object-cover object-center"
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
        >
          <source src="/videos/amerciano_uniforme.mp4" type="video/mp4" />
          Tu navegador no soporta video HTML5.
        </video>

        <!-- Borde sutil inferior oro/rubí -->
        <div class="absolute bottom-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-[#D4AF37]/80 to-transparent pointer-events-none z-20"></div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: ESPECIFICACIONES TÉCNICAS -->
    <div class="reveal-on-scroll lg:col-span-7 flex flex-col justify-between" data-reveal-delay="100">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#D4AF37] uppercase tracking-widest mb-2 font-bold">
          <span>// ESPECIFICACIONES DE COMBATE & PATRONAJE</span>
        </div>

        <h3 class="font-athletic text-3xl sm:text-4xl lg:text-5xl uppercase text-white font-black tracking-tight leading-none mb-3">
          ARMOR GRID: <span class="text-[#D4AF37]">COMBAT PERFORMANCE</span>
        </h3>

        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed mb-8">
          Equipamos a clubes de liga mayor, intermedia, juvenil y flag football. Desarrollamos cortes ceñidos con mangas tipo elástico que impiden el agarre de los defensivos rivales y maximizan la durabilidad ante el roce directo de hombreras y corazas.
        </p>

        <!-- Cuadrícula de 4 Especificaciones -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          {specsCombatArmor.map((spec) => (
            <div class="group relative p-5 rounded-2xl bg-[#121216]/90 border border-white/10 hover:border-[#D4AF37]/60 transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(212,175,55,0.15)] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="inline-block px-2.5 py-1 rounded-lg bg-black/60 border border-[#D4AF37]/30 text-[10px] font-mono text-[#D4AF37] font-bold uppercase tracking-wider">
                    {spec.badge}
                  </span>
                  <div class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-[#D4AF37] group-hover:bg-[#D4AF37] group-hover:text-black transition-colors">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={spec.icon} />
                    </svg>
                  </div>
                </div>

                <h4 class="font-athletic text-base sm:text-lg text-white uppercase tracking-wider mb-2 font-bold group-hover:text-[#D4AF37] transition-colors">
                  {spec.title}
                </h4>

                <p class="text-xs text-neutral-400 leading-relaxed mb-3">
                  {spec.description}
                </p>
              </div>

              <ul class="pt-3 border-t border-white/5 space-y-1 text-[11px] text-neutral-300 font-mono">
                {spec.features.map((feature) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-[#D4AF37] font-bold">›</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Botón Directo WhatsApp CTA -->
      <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center gap-4">
        <a 
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-red-600 hover:bg-red-500 text-white font-athletic text-sm sm:text-base uppercase tracking-wider px-8 py-4 rounded-full font-black border border-red-400/40 hover:border-amber-400/60 hover:shadow-[0_0_30px_rgba(220,38,38,0.7)] transition-all duration-300 active:scale-95 shadow-xl group"
        >
          <span>Cotizar Uniforme de Fútbol Americano</span>
          <svg class="w-4 h-4 fill-white group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24">
            <path d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <div class="flex items-center gap-3 text-xs text-neutral-400 font-mono">
          <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
          <span>Render 3D gratis con diseño de coraza y números oficiales</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initAmericanoVideo() {
    const video = document.getElementById('showcase-video-americano');
    if (!video) return;

    video.muted = true;

    if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.2 });

      videoObserver.observe(video);
    }
  })();
</script>
