---
// src/components/CtaBanner.astro
const WHATSAPP_URL = "https://wa.me/520000000000?text=Hola%20APEX%20PRO%2C%20quiero%20iniciar%20la%20cotizaci%C3%B3n%20de%20uniformes%20con%20propuesta%203D%20gratis";
---

<section id="contacto" class="py-20 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-20">
  <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out relative rounded-3xl overflow-hidden bg-gradient-to-b from-[#16161d] to-[#0d0d10] border border-[#ccff00]/40 p-8 sm:p-14 lg:p-20 text-center shadow-[0_0_50px_rgba(204,255,0,0.12)]">
    <!-- Ambient glowing accents -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-[#ccff00]/20 rounded-full blur-[90px] pointer-events-none"></div>
    <div class="absolute -bottom-24 right-10 w-80 h-40 bg-[#ccff00]/10 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#ccff00]/10 border border-[#ccff00]/40 text-[#ccff00] text-xs font-extrabold uppercase tracking-widest mb-6">
        <span>⚡ Cotización Inmediata en WhatsApp</span>
      </div>

      <!-- Heading -->
      <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white leading-tight mb-6">
        ¿Listo Para Vestir a Tu Equipo Como <span class="text-[#ccff00]">Auténticos Campeones</span>?
      </h2>

      <!-- Subtext -->
      <p class="text-neutral-300 text-base sm:text-lg max-w-2xl leading-relaxed mb-10">
        Platícanos cuántas piezas necesitas y los deportes de tu club. Te respondemos de inmediato con precios directos de taller y propuesta digital personalizada.
      </p>

      <!-- Main CTA Button -->
      <a 
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#ccff00] text-black font-athletic text-lg sm:text-xl uppercase tracking-wider px-8 sm:px-12 py-4 sm:py-5 rounded-full font-black hover:bg-white hover:text-black hover:shadow-[0_0_40px_rgba(204,255,0,0.8)] active:scale-95 transition-all duration-300 group"
        id="cta-banner-whatsapp-btn"
      >
        <svg class="w-6 h-6 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.01 2.59c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.14.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/>
        </svg>
        <span>Cotizar Mi Pedido Por WhatsApp</span>
      </a>

      <!-- Guarantees list -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-10 pt-8 border-t border-white/10 w-full text-xs sm:text-sm text-neutral-400 font-medium">
        <div class="flex items-center justify-center gap-2">
          <span class="text-[#ccff00]">✓</span>
          <span>Descuentos especiales por volumen</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-[#ccff00]">✓</span>
          <span>Muestra y Render 3D sin costo</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-[#ccff00]">✓</span>
          <span>Envíos a todo México y USA</span>
        </div>
      </div>
    </div>
  </div>
</section>
