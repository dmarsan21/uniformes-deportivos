---
// src/components/MarqueeTicker.astro
const tickerItems = [
  "SUBLIMACIÓN HD DE ALTA DEFINICIÓN",
  "PRECIOS DE MAYOREO DIRECTO DE FÁBRICA",
  "TELAS INTELIGENTES DRY-TECH ANTITRANSPIRANTES",
  "PEDIDOS MÍNIMOS DESDE 10 PIEZAS",
  "DISEÑO 3D Y MUESTRA VIRTUAL SIN COSTO",
  "ENVÍOS SEGUROS A TODO MÉXICO Y USA",
  "COSTURAS DE SEGURIDAD REFORZADAS",
  "COLORES VIVOS QUE NUNCA SE DESLAVAN"
];
---

<div class="relative w-full overflow-hidden bg-[#0e0e12] border-y border-[#D4AF37]/30 py-3 sm:py-4 shadow-[0_0_25px_rgba(212,175,55,0.12)] select-none">
  <!-- Gradient fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-[#0a0a0c] to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-[#0a0a0c] to-transparent z-10 pointer-events-none"></div>

  <!-- Marquee track -->
  <div class="flex whitespace-nowrap animate-marquee">
    <!-- Group 1 -->
    <div class="flex items-center gap-6 sm:gap-8 px-4">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-6 sm:gap-8">
          <span class="font-athletic text-base sm:text-lg lg:text-xl tracking-wider uppercase text-white font-bold flex items-center gap-2">
            <span class="text-[#D4AF37]">⚡</span>
            <span>{item}</span>
          </span>
          <span class="text-[#B30000] font-mono text-sm">//</span>
        </div>
      ))}
    </div>

    <!-- Group 2 (Duplicate for seamless loop) -->
    <div class="flex items-center gap-6 sm:gap-8 px-4" aria-hidden="true">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-6 sm:gap-8">
          <span class="font-athletic text-base sm:text-lg lg:text-xl tracking-wider uppercase text-white font-bold flex items-center gap-2">
            <span class="text-[#D4AF37]">⚡</span>
            <span>{item}</span>
          </span>
          <span class="text-[#B30000] font-mono text-sm">//</span>
        </div>
      ))}
    </div>
  </div>
</div>
