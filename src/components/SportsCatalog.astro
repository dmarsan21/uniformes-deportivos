---
// src/components/SportsCatalog.astro

interface SportCard {
  id: string;
  name: string;
  icon: string;
  garment: string;
  includes: string;
  price: string;
  image: string;
  badge: string;
  waQuery: string;
  detailUrl?: string;
}

const catalogItems: SportCard[] = [
  {
    id: "beisbol",
    name: "Béisbol & Sóftbol",
    icon: "⚾",
    garment: "Jersey botonera tradicional sublimado en cortes pro y bordado 3D.",
    includes: "Jersey pro + pantalón reforzado",
    price: "$285.00",
    image: "/images/catalog/baseball.jpg",
    badge: "Kit Pro Diamante",
    waQuery: "Béisbol & Sóftbol",
    detailUrl: "/uniformes/beisbol"
  },
  {
    id: "basquetbol",
    name: "Básquetbol",
    icon: "🏀",
    garment: "Conjunto sleeveless con cortes dinámicos y dorsales geométricos.",
    includes: "Jersey sin mangas + short reversible",
    price: "$265.00",
    image: "/images/catalog/basketball.jpg",
    badge: "Pro-Motion",
    waQuery: "Básquetbol",
    detailUrl: "/#laboratorio-ia"
  },
  {
    id: "futbol-americano",
    name: "Fútbol Americano",
    icon: "🏈",
    garment: "Jersey elástico de alto contacto con paneles de ventilación y coraza.",
    includes: "Jersey de combate + funda de compresión",
    price: "$340.00",
    image: "/images/catalog/football.jpg",
    badge: "Combat Armor Pro",
    waQuery: "Fútbol Americano",
    detailUrl: "/uniformes/futbol-americano"
  },
  {
    id: "mma-boxeo",
    name: "MMA & Boxeo",
    icon: "🥊",
    garment: "Rashguard de compresión ajustada y shorts kickboxing con refuerzo.",
    includes: "Rashguard 4-way stretch + short de combate",
    price: "$295.00",
    image: "/images/catalog/mma.jpg",
    badge: "Combat Performance",
    waQuery: "MMA & Boxeo",
    detailUrl: "/#laboratorio-ia"
  },
  {
    id: "futbol-soccer",
    name: "Fútbol Soccer",
    icon: "⚽",
    garment: "Kit completo sublimado con patrones geométricos modernos.",
    includes: "Playera dry-fit + short + calcetas profesionales",
    price: "$245.00",
    image: "/images/catalog/soccer.jpg",
    badge: "Kit Completo 3 Pzas",
    waQuery: "Fútbol Soccer",
    detailUrl: "/equipaciones#futbol-showcase"
  },
  {
    id: "ciclismo-running",
    name: "Ciclismo & Running",
    icon: "🚴",
    garment: "Jersey aerodinámico con cierre completo y bolsas traseras.",
    includes: "Jersey térmico / respirable con tiras reflectivas",
    price: "$225.00",
    image: "/images/catalog/cycling.jpg",
    badge: "Aero Speed",
    waQuery: "Ciclismo & Running"
  }
];
---

<section id="catalogo" class="py-20 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-20">
  <!-- Section Header with Scroll Reveal -->
  <div class="reveal-on-scroll flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#16161d] border border-[#D4AF37]/40 text-[#D4AF37] text-xs font-bold uppercase tracking-widest mb-4 shadow-[0_0_20px_rgba(212,175,55,0.15)]">
        <span>⚡ Catálogo de Uniformes & Paquetes</span>
      </div>
      <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white leading-tight">
        Equipaciones Completas <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37]">// Listas Para Competir</span>
      </h2>
      <p class="text-neutral-300 mt-4 text-sm sm:text-base lg:text-lg leading-relaxed">
        Precios directos de fábrica por paquete completo. Personalización total con nombres, números y logotipos de patrocinadores sin costo adicional en pedidos desde 10 piezas.
      </p>
    </div>

    <!-- Right Side Badges / Info -->
    <div class="hidden md:flex flex-col items-end gap-2 text-right">
      <div class="inline-flex items-center gap-2 text-xs font-semibold px-3.5 py-2 rounded-xl bg-white/5 border border-[#D4AF37]/30 text-neutral-300">
        <span class="w-2 h-2 rounded-full bg-[#D4AF37] animate-pulse"></span>
        <span>Muestra Virtual 3D Incluida Gratis</span>
      </div>
      <span class="text-xs text-neutral-400 font-mono">Tallas Infantiles, Juveniles y Adultos</span>
    </div>
  </div>

  <!-- Interactive Discipline Filter Tabs -->
  <div class="reveal-on-scroll flex flex-wrap gap-2.5 mb-10" id="catalog-filter-bar">
    <button 
      type="button" 
      data-filter="all" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-extrabold transition-all duration-300 bg-red-600 text-white shadow-[0_0_20px_rgba(220,38,38,0.4)] border border-red-500/60 cursor-pointer"
    >
      Todas las Disciplinas (6)
    </button>
    <button 
      type="button" 
      data-filter="beisbol" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-amber-400/50 cursor-pointer"
    >
      ⚾ Béisbol & Sóftbol
    </button>
    <button 
      type="button" 
      data-filter="basquetbol" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-amber-400/50 cursor-pointer"
    >
      🏀 Básquetbol
    </button>
    <button 
      type="button" 
      data-filter="futbol-americano" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-red-500/50 cursor-pointer"
    >
      🏈 Fútbol Americano
    </button>
    <button 
      type="button" 
      data-filter="mma-boxeo" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-amber-400/50 cursor-pointer"
    >
      🥊 MMA & Boxeo
    </button>
    <button 
      type="button" 
      data-filter="futbol-soccer" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-amber-400/50 cursor-pointer"
    >
      ⚽ Fútbol Soccer
    </button>
    <button 
      type="button" 
      data-filter="ciclismo-running" 
      class="catalog-filter-btn px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-bold transition-all duration-300 bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-amber-400/50 cursor-pointer"
    >
      🚴 Ciclismo & Running
    </button>
  </div>

  <!-- Cards Grid with Staggered Scroll Reveal, 3D Tilt & Subtle Hover Gleam -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="catalog-cards-container">
    {catalogItems.map((item, index) => {
      const cardTargetHref = item.detailUrl || `https://wa.me/520000000000?text=${encodeURIComponent(`Hola, quiero cotizar uniformes de ${item.waQuery} para un equipo.`)}`;
      const isCardExternal = !item.detailUrl;
      const waQuoteHref = `https://wa.me/520000000000?text=${encodeURIComponent(`Hola, quiero cotizar uniformes de ${item.waQuery} para un equipo.`)}`;

      return (
        <div
          data-category={item.id}
          data-tilt
          class="catalog-card reveal-on-scroll h-[480px] relative overflow-hidden group rounded-3xl border border-white/10 hover:border-[#D4AF37]/80 shadow-2xl flex flex-col justify-between p-6 bg-[#0e0e12]"
          data-reveal-delay={String(index * 100)}
        >
          <!-- Dynamic Cursor Specular Shine Overlay -->
          <div class="specular-shine absolute inset-0 z-25 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Subtle Animated Border Gleam -->
          <div class="absolute inset-0 rounded-3xl p-[1.5px] pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-[#D4AF37]/70 via-[#B30000]/40 to-[#C0C0C8]/40 z-20"></div>

          <!-- Subtle Diagonal Shimmer Sweep -->
          <div class="absolute -inset-full top-0 bg-gradient-to-r from-transparent via-white/[0.07] to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out pointer-events-none z-15"></div>

          <!-- Enlace de toda la imagen y superficie hacia la página del uniforme -->
          <a
            href={cardTargetHref}
            target={isCardExternal ? "_blank" : undefined}
            rel={isCardExternal ? "noopener noreferrer" : undefined}
            class="absolute inset-0 z-10 cursor-pointer"
            aria-label={`Ver detalles y vitrina del uniforme de ${item.name}`}
          >
            <!-- Background Photography with smooth group-hover:scale-105 transition -->
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img 
                src={item.image} 
                alt={`Uniforme deportivo de ${item.name}`}
                class="w-full h-full object-cover object-[center_12%] group-hover:scale-105 transition-transform duration-500 ease-out filter contrast-110 brightness-95 group-hover:brightness-105"
                loading="lazy"
                decoding="async"
              />
              <!-- Multi-stop Dark Gradient Overlay for Maximum Readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20 pointer-events-none"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/20 pointer-events-none"></div>
            </div>
          </a>

          <!-- Top Row: Badge + Circular Arrow Button -->
          <div class="relative z-20 pointer-events-none flex items-center justify-between w-full">
            <span class="text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-neutral-200 group-hover:border-[#D4AF37]/50 group-hover:text-[#D4AF37] transition-colors">
              {item.badge}
            </span>

            <div 
              class="w-10 h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center text-white text-base group-hover:bg-[#D4AF37] group-hover:text-black group-hover:border-[#D4AF37] group-hover:scale-110 transition-all duration-300 shadow-lg"
            >
              ↗
            </div>
          </div>

          <!-- Bottom Content -->
          <div class="relative z-20 flex flex-col justify-end pt-8 pointer-events-none">
            <!-- Thematic Icon & Garment Note -->
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl" role="img" aria-label={item.name}>{item.icon}</span>
              <span class="text-[11px] uppercase tracking-widest text-[#D4AF37] font-bold">
                {item.detailUrl ? "Ver Vitrina & Videos" : "Sublimación Pro"}
              </span>
            </div>

            <!-- Discipline Name in Ultra-Condensed Uppercase -->
            <h3 class="font-athletic text-3xl sm:text-4xl font-black uppercase tracking-tight text-white group-hover:text-[#D4AF37] transition-colors leading-none mb-2">
              {item.name}
            </h3>

            <!-- Garment Brief Description -->
            <p class="text-xs text-neutral-300 font-medium line-clamp-1 mb-2">
              {item.garment}
            </p>

            <!-- Included Garments Pill -->
            <div class="inline-flex items-center gap-1.5 text-xs text-neutral-300 bg-white/10 backdrop-blur-md border border-white/10 rounded-lg px-2.5 py-1.5 mb-4 w-fit">
              <span class="text-[#D4AF37] font-bold">Incluye:</span>
              <span>{item.includes}</span>
            </div>

            <!-- Price & WhatsApp Action Row -->
            <div class="pt-3 border-t border-white/15 flex items-center justify-between pointer-events-auto">
              <div class="flex flex-col">
                <span class="text-[10px] text-neutral-400 uppercase tracking-wider font-semibold">Mayoreo garantizado</span>
                <span class="text-sm sm:text-base text-neutral-200 font-medium">
                  Desde <strong class="text-[#D4AF37] font-athletic text-xl sm:text-2xl font-black">{item.price}</strong> <span class="text-xs text-neutral-400">/ pza</span>
                </span>
              </div>

              <a
                href={waQuoteHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wide text-white bg-red-600 hover:bg-red-500 border border-red-400/40 hover:border-amber-400/60 hover:shadow-[0_0_18px_rgba(220,38,38,0.55)] px-4 py-2 rounded-full transition-all duration-200 active:scale-95 shadow-md shadow-black/40 relative z-30 cursor-pointer"
                title={`Cotizar uniformes de ${item.name} por WhatsApp`}
              >
                <span>Cotizar</span>
                <svg class="w-3.5 h-3.5 fill-white shrink-0" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.01 2.59c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.14.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Interactive Dynamic Wholesale Calculator Strip -->
  <div class="reveal-on-scroll mt-14 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#14141c] via-[#0f0f15] to-[#14141c] border border-[#D4AF37]/30 shadow-2xl relative overflow-hidden" data-tilt>
    <div class="absolute -top-20 -right-20 w-60 h-60 bg-[#D4AF37]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 relative z-10">
      <!-- Calculator Controls -->
      <div class="w-full lg:max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4AF37]/10 border border-[#D4AF37]/30 text-[#D4AF37] text-xs font-bold uppercase tracking-wider mb-3">
          <span>⚡ Calculador Dinámico de Mayoreo</span>
        </div>
        <h4 class="font-athletic text-2xl sm:text-3xl uppercase tracking-tight text-white font-black mb-2">
          ¿Cuántos uniformes necesita tu equipo o liga?
        </h4>
        <p class="text-xs sm:text-sm text-neutral-400 mb-6">
          Desliza para calcular la escala de descuento por volumen con garantía directa de fábrica.
        </p>

        <!-- Slider Control -->
        <div class="space-y-3">
          <div class="flex justify-between items-center text-xs font-mono">
            <span class="text-neutral-400">Cantidad Seleccionada:</span>
            <span class="text-[#D4AF37] font-athletic text-xl font-black" id="calc-qty-display">25 Uniformes</span>
          </div>
          <input 
            type="range" 
            id="calc-slider" 
            min="10" 
            max="120" 
            step="5" 
            value="25"
            class="w-full accent-[#D4AF37] cursor-pointer h-2 bg-white/10 rounded-lg appearance-none"
          />
          <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
            <span>Min. 10 pzas</span>
            <span>25 pzas (Club)</span>
            <span>50 pzas (Torneo)</span>
            <span>100+ pzas (Liga)</span>
          </div>
        </div>
      </div>

      <!-- Live Calculation Result Card -->
      <div class="w-full lg:w-auto shrink-0 flex flex-col sm:flex-row items-center gap-6 p-6 rounded-2xl bg-black/60 border border-[#D4AF37]/20 backdrop-blur-md">
        <div class="text-center sm:text-left">
          <span class="text-[10px] uppercase font-mono tracking-widest text-[#D4AF37] block mb-1" id="calc-tier-badge">
            Nivel: Escala Club (-8%)
          </span>
          <div class="text-neutral-300 text-xs font-medium">Beneficios incluidos:</div>
          <div class="text-white font-bold text-sm" id="calc-benefit-text">Render 3D + Nombres y Números Gratis</div>
        </div>

        <a 
          href="https://wa.me/520000000000?text=Hola%20Alpha%20Aurea%2C%20quiero%20cotizar%20un%20pedido%20de%2025%20uniformes%20con%20descuento%20de%20mayoreo."
          id="calc-whatsapp-btn"
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto shrink-0 text-xs sm:text-sm font-extrabold uppercase tracking-wide px-7 py-3.5 rounded-full bg-red-600 hover:bg-red-500 text-white transition-all shadow-[0_0_20px_rgba(220,38,38,0.55)] border border-red-400/40 hover:border-amber-400/60 text-center"
        >
          Cotizar Este Pedido
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Filter and Calculator Logic -->
<script is:inline>
  (function initCatalogInteractivity() {
    // 1. Category Filtering
    const filterButtons = document.querySelectorAll('.catalog-filter-btn');
    const cards = document.querySelectorAll('.catalog-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Reset button states
        filterButtons.forEach((b) => {
          b.classList.remove('bg-red-600', 'text-white', 'shadow-[0_0_20px_rgba(220,38,38,0.4)]', 'border-red-500/60');
          b.classList.add('bg-[#14141a]', 'text-neutral-300', 'border-white/10');
        });

        // Activate button
        btn.classList.add('bg-red-600', 'text-white', 'shadow-[0_0_20px_rgba(220,38,38,0.4)]', 'border-red-500/60');
        btn.classList.remove('bg-[#14141a]', 'text-neutral-300', 'border-white/10');

        // Filter cards with smooth opacity/scale
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0) scale(1)';
            }, 50);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(15px) scale(0.96)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 250);
          }
        });
      });
    });

    // 2. Interactive Calculator
    const slider = document.getElementById('calc-slider');
    const qtyDisplay = document.getElementById('calc-qty-display');
    const tierBadge = document.getElementById('calc-tier-badge');
    const benefitText = document.getElementById('calc-benefit-text');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    if (slider && qtyDisplay && tierBadge && benefitText && waBtn) {
      slider.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        qtyDisplay.textContent = `${val} Uniformes`;

        let tier = "Nivel Base de Taller";
        let benefit = "Render 3D + Nombres y Números Gratis";

        if (val >= 100) {
          tier = "Nivel Liga Profesional (-22%)";
          benefit = "Envío Express Gratis + Muestra Física + Render 3D";
        } else if (val >= 50) {
          tier = "Nivel Torneo Mayor (-15%)";
          benefit = "Envío Prioritario Gratis + Render 3D 360°";
        } else if (val >= 25) {
          tier = "Nivel Escala Club (-8%)";
          benefit = "Render 3D + Escudos y Nombres Ilimitados";
        }

        tierBadge.textContent = tier;
        benefitText.textContent = benefit;
        waBtn.href = `https://wa.me/520000000000?text=${encodeURIComponent(
          `Hola APEX PRO, utilicé su calculador dinámico y deseo cotizar ${val} uniformes con beneficios de ${tier}.`
        )}`;
      });
    }
  })();
</script>
