---
// src/components/Navbar.astro
const WHATSAPP_URL = "https://wa.me/520000000000?text=Hola%20Alpha%20Aurea%2C%20quiero%20cotizar%20uniformes%20deportivos%20para%20mi%20equipo";
---

<header class="fixed top-0 left-0 right-0 w-full z-50 bg-[#0a0a0c]/90 backdrop-blur-xl border-b border-[#D4AF37]/20 shadow-xl shadow-black/60 transition-all duration-300">
  <div class="w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Logo Alpha Aurea -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2.5 group shrink-0" aria-label="Alpha Aurea Inicio">
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-red-600 border border-red-500/80 shadow-md shadow-red-950/60 flex items-center justify-center font-athletic text-white text-base sm:text-lg font-black group-hover:scale-105 group-hover:shadow-[0_0_18px_rgba(220,38,38,0.7)] transition-all">
        Α
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2">
        <span class="font-athletic text-lg sm:text-2xl tracking-wider text-white font-black uppercase">ALPHA</span>
        <span class="text-xs sm:text-sm font-black tracking-widest text-white uppercase border-l border-white/20 pl-1.5 sm:pl-2">AUREA</span>
      </div>
    </a>

    <!-- Desktop Navigation Links: 49ers Cohesive Palette -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-xs xl:text-sm font-bold tracking-wider uppercase text-neutral-300" aria-label="Navegación principal">
      
      <!-- BOTÓN INICIO CON ICONO -->
      <a 
        href="/" 
        class="flex items-center gap-1.5 hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap text-white font-bold"
        aria-label="Ir a página de Inicio"
      >
        <svg class="w-4 h-4 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Inicio</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <!-- DROPDOWN: UNIFORMES CON SUBMENÚ DE DEPORTES -->
      <div class="relative group/nav-dropdown py-2">
        <button 
          type="button" 
          class="flex items-center gap-1.5 hover:text-[#D4AF37] transition-colors py-1 cursor-pointer font-bold uppercase tracking-wider text-white"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] animate-pulse"></span>
          <span>Uniformes</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/nav-dropdown:rotate-180 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Menú Desplegable Flotante -->
        <div class="absolute top-full left-0 pt-2 w-72 opacity-0 pointer-events-none group-hover/nav-dropdown:opacity-100 group-hover/nav-dropdown:pointer-events-auto transition-all duration-200 transform origin-top -translate-y-2 group-hover/nav-dropdown:translate-y-0 z-50">
          <div class="bg-[#101015]/95 backdrop-blur-2xl border border-[#D4AF37]/30 rounded-2xl p-2.5 shadow-2xl shadow-black/80">
            <div class="px-3 py-1.5 text-[10px] font-mono text-[#D4AF37] uppercase tracking-widest font-bold border-b border-white/5 mb-1">
              // DISCIPLINAS DISPONIBLES
            </div>

            <!-- Béisbol & Softbol -->
            <a 
              href="/uniformes/beisbol" 
              class="flex items-center gap-3 p-2.5 rounded-xl bg-[#D4AF37]/10 border border-[#D4AF37]/30 hover:bg-[#D4AF37] text-white hover:text-black transition-all group/subitem mb-1"
            >
              <span class="text-lg">⚾</span>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-athletic text-sm uppercase tracking-wide font-black">Béisbol & Softbol</span>
                  <span class="text-[9px] px-1.5 py-0.2 rounded bg-[#D4AF37] text-black font-extrabold group-hover/subitem:bg-black group-hover/subitem:text-[#D4AF37]">TOP</span>
                </div>
                <span class="text-[11px] text-neutral-300 group-hover/subitem:text-neutral-900 block font-normal leading-tight">Línea Diamante Pro 360°</span>
              </div>
            </a>

            <!-- Fútbol Americano -->
            <a 
              href="/uniformes/futbol-americano" 
              class="flex items-center gap-3 p-2.5 rounded-xl bg-[#B30000]/15 border border-[#B30000]/40 hover:bg-[#B30000] text-white transition-all group/subitem mb-1 shadow-md"
            >
              <span class="text-lg">🏈</span>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-athletic text-sm uppercase tracking-wide font-black">Fútbol Americano</span>
                  <span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-400 text-neutral-950 font-extrabold">COMBAT PRO</span>
                </div>
                <span class="text-[11px] text-neutral-300 group-hover/subitem:text-white block font-normal leading-tight">Combat Armor & Galería 3D</span>
              </div>
            </a>

            <!-- Fútbol Soccer -->
            <a 
              href="/#catalogo" 
              class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/5 text-neutral-300 hover:text-white transition-colors group/subitem"
            >
              <span class="text-lg">⚽</span>
              <div>
                <span class="font-athletic text-sm uppercase tracking-wide font-bold block">Fútbol Soccer</span>
                <span class="text-[11px] text-neutral-400 group-hover/subitem:text-[#D4AF37] block font-normal leading-tight">Kit 3 Piezas Dry-Tech</span>
              </div>
            </a>

            <!-- Básquetbol -->
            <a 
              href="/#laboratorio-ia" 
              class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/5 text-neutral-300 hover:text-white transition-colors group/subitem"
            >
              <span class="text-lg">🏀</span>
              <div>
                <span class="font-athletic text-sm uppercase tracking-wide font-bold block">Básquetbol</span>
                <span class="text-[11px] text-neutral-400 group-hover/subitem:text-[#D4AF37] block font-normal leading-tight">Sleeveless Reversible</span>
              </div>
            </a>

            <!-- MMA & Artes Marciales -->
            <a 
              href="/#laboratorio-ia" 
              class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/5 text-neutral-300 hover:text-white transition-colors group/subitem"
            >
              <span class="text-lg">🥊</span>
              <div>
                <span class="font-athletic text-sm uppercase tracking-wide font-bold block">MMA & Combate</span>
                <span class="text-[11px] text-neutral-400 group-hover/subitem:text-[#D4AF37] block font-normal leading-tight">Rashguards & Fight Shorts</span>
              </div>
            </a>

            <!-- Ver Todo el Catálogo -->
            <div class="pt-1.5 mt-1 border-t border-white/5">
              <a 
                href="/#catalogo" 
                class="flex items-center justify-between p-2 rounded-lg text-xs font-mono text-[#D4AF37] hover:bg-white/5 font-bold"
              >
                <span>Ver todas las disciplinas</span>
                <span>➔</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <a href="/#catalogo" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        Catálogo
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <a href="/#parallax-lab" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        IA Lab
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <a href="/#fabricacion" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        Fabricación
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <a href="/#laboratorio-ia" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        Modelos 360°
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <a href="/#proceso" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        Proceso
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>

      <a href="/#contacto" class="hover:text-[#D4AF37] transition-colors py-1 relative group whitespace-nowrap">
        Contacto
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-200 group-hover:w-full"></span>
      </a>
    </nav>

    <!-- CTA & Mobile Button -->
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      <a 
        href={WHATSAPP_URL} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2.5 bg-red-600 hover:bg-red-500 text-white font-extrabold text-[11px] sm:text-sm uppercase tracking-wide px-3 sm:px-5 py-2 sm:py-2.5 rounded-full border border-red-400/40 hover:border-amber-400/60 hover:shadow-[0_0_20px_rgba(220,38,38,0.55)] active:scale-95 transition-all duration-200 shadow-md shadow-black/40"
        id="nav-cta-btn"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-white shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.01 2.59c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.14.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/>
        </svg>
        <span class="tracking-wider font-bold">Cotizar</span>
      </a>

      <!-- Mobile Toggle Button (Hamburguesa 100% visible) -->
      <button 
        id="mobile-menu-toggle"
        class="lg:hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/5 border border-white/15 flex items-center justify-center text-white hover:text-[#D4AF37] hover:border-[#D4AF37]/50 transition-colors shrink-0"
        aria-label="Abrir menú móvil"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu"
    class="hidden lg:hidden w-full border-t border-white/10 bg-[#0a0a0c]/98 backdrop-blur-2xl px-6 py-6 max-h-[85vh] overflow-y-auto"
  >
    <div class="flex flex-col gap-3 text-left">
      <!-- Enlace Inicio en Móvil -->
      <a 
        href="/" 
        class="text-sm font-bold uppercase tracking-wider text-white hover:text-[#D4AF37] py-2 border-b border-white/10 mobile-link flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Inicio</span>
      </a>

      <!-- Sección Uniformes en Móvil -->
      <div class="pb-3 border-b border-white/10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#D4AF37] block mb-2">
          ⚡ UNIFORMES POR DEPORTE
        </span>
        <div class="grid grid-cols-1 gap-2 pl-2">
          <a 
            href="/uniformes/beisbol" 
            class="mobile-link flex items-center justify-between p-2.5 rounded-xl bg-[#D4AF37]/15 border border-[#D4AF37]/40 text-white"
          >
            <span class="font-athletic text-sm uppercase flex items-center gap-2">
              <span>⚾</span> Béisbol & Softbol
            </span>
            <span class="text-[9px] px-1.5 py-0.5 rounded bg-[#D4AF37] text-black font-extrabold">DESTACADO</span>
          </a>

          <a 
            href="/uniformes/futbol-americano" 
            class="mobile-link flex items-center justify-between p-2.5 rounded-xl bg-[#B30000]/20 border border-[#B30000]/50 text-white"
          >
            <span class="font-athletic text-sm uppercase flex items-center gap-2">
              <span>🏈</span> Fútbol Americano
            </span>
            <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-400 text-neutral-950 font-extrabold">COMBAT</span>
          </a>

          <a 
            href="/#catalogo" 
            class="mobile-link flex items-center gap-2 text-sm font-semibold text-neutral-300 hover:text-white py-1.5"
          >
            <span>⚽</span> Fútbol Soccer
          </a>

          <a 
            href="/#laboratorio-ia" 
            class="mobile-link flex items-center gap-2 text-sm font-semibold text-neutral-300 hover:text-white py-1.5"
          >
            <span>🏀</span> Básquetbol
          </a>

          <a 
            href="/#laboratorio-ia" 
            class="mobile-link flex items-center gap-2 text-sm font-semibold text-neutral-300 hover:text-white py-1.5"
          >
            <span>🥊</span> MMA & Boxeo
          </a>
        </div>
      </div>

      <a href="/#catalogo" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 border-b border-white/5 mobile-link">Catálogo & Precios</a>
      <a href="/#parallax-lab" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 border-b border-white/5 mobile-link">IA Parallax Lab</a>
      <a href="/#fabricacion" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 border-b border-white/5 mobile-link">Fabricación & Tecnología</a>
      <a href="/#laboratorio-ia" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 border-b border-white/5 mobile-link">Modelos 360°</a>
      <a href="/#proceso" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 border-b border-white/5 mobile-link">Proceso</a>
      <a href="/#contacto" class="text-sm font-bold uppercase tracking-wider text-neutral-200 hover:text-[#D4AF37] py-2 mobile-link">Contacto Directo</a>
      
      <a 
        href={WHATSAPP_URL} 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full bg-red-600 hover:bg-red-500 text-white font-extrabold uppercase py-3 rounded-xl tracking-wider text-sm flex items-center justify-center gap-2 mt-2 shadow-lg shadow-black/40 border border-red-500/50 transition-colors"
      >
        <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.01 2.59c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.14.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/>
        </svg>
        <span class="font-bold">Hablar con un Asesor</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
