                  <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
                  <span>VISTA FRENTE // Escudo & Pecho</span>
                </div>

                <!-- Hover hint callout -->
                <div class="absolute bottom-4 left-4 right-4 z-10 flex items-center justify-between text-xs font-mono px-4 py-2 rounded-xl bg-black/75 backdrop-blur-md border border-white/10 text-neutral-300 pointer-events-none">
                  <span class="text-[#ccff00] font-bold flex items-center gap-1.5">
                    <span class="animate-spin text-sm">⟳</span> Pasa el cursor para girar
                  </span>
                  <span class="text-neutral-400">Ver Espalda 360° ➔</span>
                </div>
              </div>

              <!-- BACK FACE (180deg) -->
              <div class="turnaround-back bg-[#0a0a0e]">
                <img 
                  src={sport.backImage} 
                  alt={sport.altBack}
                  class="w-full h-full object-cover object-center filter contrast-105"
                  loading="lazy"
                />
                <!-- Gradient Shadows for Readability -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/30 pointer-events-none"></div>

                <!-- View Badge: Back -->
                <div class="absolute top-4 left-4 z-10 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/80 backdrop-blur-md border border-cyan-400/60 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider shadow-lg">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                  <span>VISTA ESPALDA // Dorsal & Número</span>
                </div>

                <!-- Return hint callout -->
                <div class="absolute bottom-4 left-4 right-4 z-10 flex items-center justify-between text-xs font-mono px-4 py-2 rounded-xl bg-black/75 backdrop-blur-md border border-white/10 text-neutral-300 pointer-events-none">
                  <span class="text-cyan-300 font-bold flex items-center gap-1.5">
                    <span>✓</span> Nombre & Número Personalizado
                  </span>
                  <span class="text-neutral-400">Ver Frente ➔</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Interactive Manual View Toggle Buttons -->
          <div class="flex items-center gap-2.5 mt-5">
            <button
              type="button"
              class="btn-rotate-front px-4 py-2 rounded-xl text-xs font-athletic uppercase tracking-wider font-bold bg-[#ccff00] text-black shadow-md cursor-pointer transition-all hover:scale-105 active:scale-95"
              data-target-card={`turnaround-card-${sport.id}`}
            >
              👕 Vista Frente
            </button>
            <button
              type="button"
              class="btn-rotate-back px-4 py-2 rounded-xl text-xs font-athletic uppercase tracking-wider font-bold bg-[#181822] text-neutral-300 hover:text-white border border-white/15 hover:border-[#ccff00]/50 cursor-pointer transition-all hover:scale-105 active:scale-95"
              data-target-card={`turnaround-card-${sport.id}`}
            >
              🔄 Vista Espalda (360°)
            </button>
            <button
              type="button"
              class="btn-rotate-toggle p-2 rounded-xl text-xs bg-white/5 border border-white/10 hover:border-[#ccff00] text-[#ccff00] cursor-pointer transition-all hover:scale-105"
              title="Girar Uniforme"
              data-target-card={`turnaround-card-${sport.id}`}
            >
              ⟳ Girar
            </button>
          </div>
        </div>

        <!-- Right: Technical Breakdown & Uniform Details -->
        <div class="lg:col-span-6 flex flex-col justify-between py-2">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-[#ccff00] uppercase tracking-widest mb-2 font-bold">
              <span>// EQUIPACIÓN MODELADA EN VIVO</span>
            </div>

            <h3 class="font-athletic text-3xl sm:text-4xl lg:text-5xl uppercase text-white font-black tracking-tight leading-none mb-3">
              {sport.sportName}
            </h3>

            <p class="text-xs sm:text-sm font-semibold text-[#ccff00] mb-4 font-mono">
              › {sport.kitName}
            </p>

            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed mb-6">
              {sport.description}
            </p>

            <!-- Front vs Back Customization Comparison Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <!-- Front highlights -->
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
                <span class="text-xs font-athletic uppercase text-[#ccff00] font-bold block mb-2">
                  👕 Vista Frontal (Pecho)
                </span>
                <ul class="space-y-1.5 text-xs text-neutral-300">
                  {sport.frontHighlights.map((fh) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-[#ccff00] font-bold mt-0.5">›</span>
                      <span>{fh}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Back highlights -->
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
                <span class="text-xs font-athletic uppercase text-cyan-400 font-bold block mb-2">
                  🔄 Vista Dorsal (Espalda)
                </span>
                <ul class="space-y-1.5 text-xs text-neutral-300">
                  {sport.backHighlights.map((bh) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-cyan-400 font-bold mt-0.5">›</span>
                      <span>{bh}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Technical Specs Grid -->
            <div class="grid grid-cols-2 gap-2.5 mb-8">
              {sport.specs.map((sp) => (
                <div class="p-3 rounded-xl bg-black/40 border border-white/5">
                  <span class="text-[10px] uppercase font-mono text-neutral-500 block">{sp.label}</span>
                  <span class="text-xs font-bold text-neutral-200">{sp.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- WhatsApp Customization Action -->
          <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center gap-4">
            <a 
              href={`https://wa.me/520000000000?text=${encodeURIComponent(`Hola APEX PRO, vi el modelo interactivo 360° de ${sport.waQuery} y quiero cotizar uniformes con diseño 3D personalizado.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2.5 bg-[#ccff00] text-black font-athletic text-sm sm:text-base uppercase tracking-wider px-7 py-4 rounded-full font-bold hover:bg-white hover:shadow-[0_0_30px_rgba(204,255,0,0.7)] transition-all duration-300 active:scale-95 shadow-xl"
            >
              <span>Cotizar {sport.sportName} con Render 3D</span>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Interactive 360 Turnaround Script -->
<script is:inline>
  (function initTurnaround360() {
    // 1. Sport Tabs Navigation
    const tabButtons = document.querySelectorAll('.sport360-tab-btn');
    const panels = document.querySelectorAll('.sport-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-sport-target');

        tabButtons.forEach((b) => {
          b.classList.remove('bg-[#ccff00]', 'text-black', 'shadow-[0_0_25px_rgba(204,255,0,0.4)]', 'scale-102');
          b.classList.add('bg-[#14141a]', 'text-neutral-300', 'border', 'border-white/10');
        });

        btn.classList.add('bg-[#ccff00]', 'text-black', 'shadow-[0_0_25px_rgba(204,255,0,0.4)]', 'scale-102');
        btn.classList.remove('bg-[#14141a]', 'text-neutral-300', 'border', 'border-white/10');

        panels.forEach((p) => p.classList.add('hidden'));

        const targetPanel = document.getElementById(`sport-panel-${targetId}`);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // 2. 360° Hover Flip & Click Toggle Logic
    const stages = document.querySelectorAll('.turnaround-perspective');

    stages.forEach((stage) => {
      const card = stage.querySelector('.turnaround-card');
      if (!card) return;

      // On mouse enter / hover -> flip to back view
      stage.addEventListener('pointerenter', () => {
        card.classList.add('is-flipped');
      });

      // On mouse leave -> flip back to front view
      stage.addEventListener('pointerleave', () => {
        card.classList.remove('is-flipped');
      });

      // On click/tap -> toggle flip (perfect for mobile & touchscreens)
      stage.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });

    // 3. Manual Button Controls
    document.querySelectorAll('.btn-rotate-front').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cardId = btn.getAttribute('data-target-card');
        const card = document.getElementById(cardId);
        if (card) {
          card.classList.remove('is-flipped');
        }
      });
    });

    document.querySelectorAll('.btn-rotate-back').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cardId = btn.getAttribute('data-target-card');
        const card = document.getElementById(cardId);
        if (card) {
          card.classList.add('is-flipped');
        }
      });
    });

    document.querySelectorAll('.btn-rotate-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cardId = btn.getAttribute('data-target-card');
        const card = document.getElementById(cardId);
        if (card) {
          card.classList.toggle('is-flipped');
        }
      });
    });
  })();
</script>
