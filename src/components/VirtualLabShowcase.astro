            class="turnaround-perspective relative w-full max-w-[420px] aspect-[3/4] rounded-3xl overflow-hidden cursor-pointer group shadow-[0_15px_40px_rgba(0,0,0,0.8)] border border-white/15 hover:border-[#ccff00]/60 transition-colors"
            id={`turnaround-stage-${sport.id}`}
            title="Pasa el cursor o haz clic para girar 360°"
          >
            <!-- Card that rotates 180 degrees in 3D space -->
            <div class="turnaround-card w-full h-full" id={`turnaround-card-${sport.id}`}>
              <!-- FRONT FACE -->
