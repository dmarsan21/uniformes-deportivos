---

<section id="laboratorio-ia" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto relative scroll-mt-20 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/3 left-1/4 -translate-y-1/2 w-[700px] h-[350px] bg-[#ccff00]/5 rounded-full blur-[180px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[280px] bg-cyan-500/5 rounded-full blur-[160px] pointer-events-none"></div>

  <!-- Header Block with Scroll Reveal -->
  <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 relative z-10">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#16161d] border border-[#ccff00]/40 text-[#ccff00] text-xs font-bold uppercase tracking-widest mb-4 shadow-[0_0_20px_rgba(204,255,0,0.15)]">
        <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
        <span>Simulador Interactivo // Modelos En Vivo 360°</span>
      </div>
      <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white leading-tight">
        Visualización 360° <span class="text-[#ccff00] drop-shadow-[0_0_30px_rgba(204,255,0,0.4)]">// Frente & Espalda</span>
      </h2>
      <p class="text-neutral-300 mt-4 text-sm sm:text-base lg:text-lg leading-relaxed">
        Pasa el cursor sobre la imagen o usa los controles para girar al atleta 360°. Revisa cómo luce cada equipación de frente (escudo y pecho) y de espalda (nombre, número oficial y paneles de ventilación).
      </p>
    </div>

    <!-- Active Indicator Pill -->
    <div class="hidden lg:flex items-center gap-2 text-xs font-mono text-neutral-400 bg-white/5 border border-white/10 px-4 py-2.5 rounded-2xl backdrop-blur-md">
      <span class="w-2.5 h-2.5 rounded-full bg-[#ccff00] animate-ping"></span>
      <span class="text-white font-bold uppercase tracking-wider">Interactividad 360° Activa</span>
    </div>
  </div>

  <!-- Sport Selection Tabs -->
  <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out flex flex-wrap gap-3 mb-8 relative z-10" id="sports360-tab-buttons">
    {sports360.map((sport, index) => (
      <button
        type="button"
        data-sport-target={sport.id}
        class={`sport360-tab-btn px-5 py-3 rounded-2xl text-xs sm:text-sm font-athletic uppercase tracking-wider font-bold transition-all duration-300 flex items-center gap-2.5 cursor-pointer ${
          index === 0
            ? "bg-[#ccff00] text-black shadow-[0_0_25px_rgba(204,255,0,0.4)] scale-102"
            : "bg-[#14141a] text-neutral-300 hover:text-white border border-white/10 hover:border-[#ccff00]/50"
        }`}
      >
        <span>{sport.tabLabel}</span>
      </button>
    ))}
  </div>

  <!-- Main 360 Showcase Container -->
  <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out relative rounded-3xl overflow-hidden bg-[#0e0e14] border border-white/10 p-4 sm:p-8 lg:p-10 shadow-2xl z-10">
    <!-- Glowing Border Accent -->
    <div class="absolute inset-0 rounded-3xl p-[1px] pointer-events-none bg-gradient-to-br from-[#ccff00]/40 via-cyan-500/10 to-transparent"></div>

    {sports360.map((sport, index) => (
      <div 
        id={`sport-panel-${sport.id}`} 
        class={`sport-panel grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center ${index === 0 ? 'block' : 'hidden'}`}
      >
        <!-- Left: Interactive 360° Turnaround Stage -->
        <div class="lg:col-span-6 flex flex-col items-center">
          <!-- 3D Perspective Card Container -->
