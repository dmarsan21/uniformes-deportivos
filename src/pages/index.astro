---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import SportsCatalog from '../components/SportsCatalog.astro';
import ManufacturingProcess from '../components/ManufacturingProcess.astro';
import VirtualLabShowcase from '../components/VirtualLabShowcase.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Process from '../components/Process.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="APEX PRO // Uniformes Deportivos de Alto Rendimiento">
  <main class="bg-[#0a0a0c] text-white min-h-screen overflow-x-hidden selection:bg-[#ccff00] selection:text-black">
    <Navbar/>
    <Hero/>
    <MarqueeTicker/>
    <SportsCatalog/>
    <ManufacturingProcess/>
    <VirtualLabShowcase/>
    <BentoGrid/>
    <Process/>
    <CtaBanner/>
    <Footer/>
  </main>
</Layout>
