---
// src/pages/uniformes/futbol-americano.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import FootballShowcase from '../../components/FootballShowcase.astro';
import FootballGallerySection from '../../components/FootballGallerySection.astro';
import Footer from '../../components/Footer.astro';

const WHATSAPP_URL = "https://wa.me/520000000000?text=" + encodeURIComponent("Hola Alpha Aurea, quiero cotizar uniformes de Fútbol Americano Combat Armor para mi equipo/liga.");

const highlights = [
  {
    title: "Malla Heavy 400g / Spandex",
    desc: "Estructura elástica de alta densidad que se ajusta a la coraza sin dejar tela suelta para tirones.",
    icon: "🛡️"
  },
  {
    title: "Costura Flatlock Grado Militar",
    desc: "Unión de cuádruple hilo continuo que soporta colisiones violentas y agarres bruscos en la línea de scrimmage.",
    icon: "⚡"
  },
  {
    title: "Fundas con Bolsas para Tablas",
    desc: "Bolsillos reforzados para pads de muslo, cadera y rodillas, o versión integrada lista para el juego.",
    icon: "🏈"
  },
  {
    title: "Sublimación Digital Térmica",
    desc: "Números oficiales de alto impacto, nombres y franjas en hombreras sin desprendimiento ni deslavado.",
    icon: "🔥"
  }
];
---

<Layout 
  title="Fútbol Americano de Alto Rendimiento // Alpha Aurea" 
  description="Uniformes de fútbol americano de grado profesional y máximo contacto. Jerseys reforzados con elastano 400g, fundas de juego integradas y números oficiales."
>
  <main class="bg-[#0a0a0c] text-white min-h-screen overflow-x-hidden selection:bg-[#D4AF37] selection:text-black pt-20">
    <Navbar />

    <!-- HERO DE LA DISCIPLINA FÚTBOL AMERICANO -->
    <section class="relative py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden">
      <!-- Glow ambiental de fondo: Rubí y Oro -->
      <div class="parallax-element absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-r from-[#B30000]/25 via-[#D4AF37]/20 to-[#C0C0C8]/15 rounded-full blur-[170px] pointer-events-none" data-parallax-y="-0.2"></div>

      <!-- Watermark Cinético de Fondo -->
      <div class="absolute top-10 left-0 w-full overflow-hidden pointer-events-none select-none z-0 opacity-10">
        <div class="parallax-element whitespace-nowrap font-athletic text-7xl sm:text-9xl uppercase tracking-wider text-stroke-gold" data-parallax-x="0.25">
          AMERICANO // COMBAT ARMOR // 400G SPANDEX // CORAZA // ORO & CARMESÍ
        </div>
      </div>

      <div class="relative z-10 text-center max-w-4xl mx-auto">
        <!-- Breadcrumb / Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#16161d] border border-[#D4AF37]/40 text-[#D4AF37] text-xs font-bold uppercase tracking-widest mb-6 shadow-[0_0_20px_rgba(212,175,55,0.2)]">
          <span class="w-2 h-2 rounded-full bg-[#B30000] animate-pulse"></span>
          <span>Uniformes Deportivos // Fútbol Americano</span>
        </div>

        <h1 class="font-athletic text-4xl sm:text-6xl lg:text-7xl xl:text-8xl uppercase tracking-tight text-white leading-[0.92] mb-6">
          Fútbol Americano de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37] drop-shadow-[0_0_35px_rgba(212,175,55,0.5)]">Alto Impacto</span>
        </h1>

        <p class="text-neutral-300 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Equipaciones blindadas contra tirones, colisiones y agarres violentos. Diseñadas para ceñirse a la coraza con máxima ventilación en costillas y durabilidad probada en contacto real.
        </p>

        <!-- CTA Rápido -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a 
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-red-600 hover:bg-red-500 text-white font-athletic uppercase tracking-wider text-sm sm:text-base font-black border border-red-400/40 hover:border-amber-400/60 hover:shadow-[0_0_30px_rgba(220,38,38,0.7)] transition-all duration-300 active:scale-95 shadow-xl group"
          >
            <span>Cotizar Equipación Completa</span>
            <svg class="w-4 h-4 fill-white group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24">
              <path d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a 
            href="#vitrina-americano"
            class="inline-flex items-center gap-2 px-6 py-4 rounded-full bg-white/5 hover:bg-white/10 text-white font-athletic uppercase tracking-wider text-sm font-bold border border-[#D4AF37]/30 hover:border-[#D4AF37] transition-all duration-300"
          >
            <span>Ver Vitrina Interactiva ↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- VENTAJAS TÉCNICAS RÁPIDAS -->
    <section class="py-8 px-4 sm:px-6 max-w-7xl mx-auto relative z-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {highlights.map((item) => (
          <div class="p-6 rounded-2xl bg-[#121216]/80 border border-white/10 hover:border-[#D4AF37]/60 transition-colors shadow-lg">
            <span class="text-2xl mb-3 block">{item.icon}</span>
            <h3 class="font-athletic text-base sm:text-lg uppercase text-white tracking-wider mb-2 font-bold">
              {item.title}
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA PRINCIPAL: VITRINA VIDEO Y OPCIONES DE FABRICACIÓN -->
    <div id="vitrina-americano" class="scroll-mt-24">
      <FootballShowcase />
    </div>

    <!-- SECCIÓN DE GALERÍA DE JERSEYS DE FÚTBOL AMERICANO: MODELOS RELÁMPAGO, VALQUIRIAS Y DYNOS -->
    <FootballGallerySection />

    <!-- CALL TO ACTION FINAL DE DISCIPLINA -->
    <section class="py-20 px-4 sm:px-6 max-w-7xl mx-auto relative overflow-hidden">
      <div class="rounded-3xl bg-gradient-to-r from-[#121216] via-[#1a1315] to-[#121216] border border-[#D4AF37]/30 p-8 sm:p-14 relative overflow-hidden text-center shadow-2xl">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#D4AF37]/10 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#D4AF37] block mb-3">
            // PEDIDOS DESDE 10 EQUIPACIONES COMPLETAS
          </span>
          <h2 class="font-athletic text-3xl sm:text-5xl uppercase tracking-tight text-white mb-4">
            ¿Listo para Uniformar a Tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#D4AF37]">Equipo o Franquicia</span>?
          </h2>
          <p class="text-neutral-300 text-sm sm:text-base leading-relaxed mb-8">
            Envíanos los colores de tu escuadra, logotipos y lista de dorsales. Te entregamos el render 3D con colocación exacta de coraza y parches en menos de 24 horas.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-red-600 hover:bg-red-500 text-white font-athletic text-sm sm:text-base uppercase tracking-wider px-8 py-4 rounded-full font-black border border-red-400/40 hover:border-amber-400/60 hover:shadow-[0_0_30px_rgba(220,38,38,0.7)] transition-all duration-300 active:scale-95 shadow-xl"
            >
              <span>Solicitar Cotización Inmediata</span>
              <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                <path d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>

            <a 
              href="/#catalogo" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-white/5 hover:bg-white/10 text-white font-athletic uppercase tracking-wider text-sm font-bold border border-white/10 hover:border-[#D4AF37]/50 transition-colors"
            >
              <span>Explorar Otras Disciplinas</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
