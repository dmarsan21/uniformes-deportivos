---
// src/pages/equipaciones.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const WHATSAPP_URL = "https://wa.me/520000000000?text=Hola%20APEX%20PRO%2C%20quiero%20cotizar%20uniformes%20deportivos%20completos";
---

<Layout title="APEX PRO // Anatomía de Equipaciones: Fútbol & Americano">
  <main class="bg-[#0a0a0c] text-white min-h-screen overflow-x-hidden selection:bg-[#ccff00] selection:text-black pt-20">
    <Navbar />

    <!-- HERO DE LA PÁGINA -->
    <section class="relative py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden">
      <div class="parallax-element absolute -top-20 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#ccff00]/10 rounded-full blur-[160px] pointer-events-none" data-parallax-y="-0.2"></div>

      <!-- Marcas cinéticas de fondo -->
      <div class="absolute top-10 left-0 w-full overflow-hidden pointer-events-none select-none z-0 opacity-10">
        <div class="parallax-element whitespace-nowrap font-athletic text-7xl sm:text-9xl uppercase tracking-wider text-stroke-volt" data-parallax-x="0.3">
          ANATOMÍA // EQUIPACIONES // FÚTBOL // AMERICANO // DRY-TECH // IMPACTO
        </div>
      </div>

      <div class="relative z-10 text-center max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#16161d] border border-[#ccff00]/40 text-[#ccff00] text-xs font-bold uppercase tracking-widest mb-6 shadow-[0_0_20px_rgba(204,255,0,0.15)]">
          <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
          <span>Desglose Técnico & Video Demostrativo</span>
        </div>

        <h1 class="font-athletic text-4xl sm:text-6xl lg:text-7xl uppercase tracking-tight text-white leading-[0.95] mb-6">
          ¿Qué Incluye Cada <span class="text-[#ccff00] drop-shadow-[0_0_35px_rgba(204,255,0,0.4)]">Uniforme APEX PRO</span>?
        </h1>

        <p class="text-neutral-300 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl mx-auto mb-10">
          Conoce exactamente lo que recibe tu club en cada paquete: piezas entregadas, tecnologías moleculares del tejido, acabados de costura y reproducción de video cinemático en tiempo real con scroll.
        </p>

        <!-- Selector rápido de disciplina con ancla suave -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a 
            href="#futbol-showcase" 
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#14141c] hover:bg-[#ccff00] text-white hover:text-black font-athletic uppercase tracking-wider text-sm font-bold border border-white/10 hover:border-[#ccff00] transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(204,255,0,0.4)] group"
          >
            <span>⚽ Ver Equipación de Fútbol</span>
            <span class="text-xs text-neutral-400 group-hover:text-black">↓</span>
          </a>
          <a 
            href="#americano-showcase" 
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#14141c] hover:bg-[#ccff00] text-white hover:text-black font-athletic uppercase tracking-wider text-sm font-bold border border-white/10 hover:border-[#ccff00] transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(204,255,0,0.4)] group"
          >
            <span>🏈 Ver Equipación de Americano</span>
            <span class="text-xs text-neutral-400 group-hover:text-black">↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECCIÓN 1: FÚTBOL SOCCER (VIDEO + DESGLOSE) -->
    <!-- ========================================== -->
    <section id="futbol-showcase" class="py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-24 border-t border-white/10 relative">
      <div class="parallax-element absolute top-1/4 -left-32 w-96 h-96 bg-[#ccff00]/5 rounded-full blur-[140px] pointer-events-none" data-parallax-y="0.15"></div>

      <!-- Header de Disciplina -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#ccff00] mb-2">
            <span>DISCIPLINA // 01</span>
            <span>•</span>
            <span>90 MINUTOS DE ALTO RENDIMIENTO</span>
          </div>
          <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white">
            Equipación Pro <span class="text-[#ccff00]">// Fútbol Soccer</span>
          </h2>
        </div>
        <div class="text-neutral-400 text-xs sm:text-sm font-mono flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-xl backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-ping"></span>
          <span>Video Autoplay con Scroll Activo</span>
        </div>
      </div>

      <!-- Grid Principal: Video Scroll + Fichas Técnicas -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative z-10">
        
        <!-- COLUMNA IZQUIERDA: VIDEO CON AUTOPLAY ON SCROLL (Sticky en pantallas grandes) -->
        <div class="lg:col-span-6 lg:sticky lg:top-28">
          <div class="relative rounded-3xl overflow-hidden bg-[#0e0e14] border border-[#ccff00]/30 shadow-[0_20px_50px_rgba(0,0,0,0.8)] group">
            
            <!-- Video Element: paused until scrolled into viewport -->
            <video 
              data-scroll-video
              id="video-futbol"
              loop 
              muted 
              playsinline 
              preload="metadata"
              class="w-full aspect-[4/3] sm:aspect-[16/10] object-cover object-center filter contrast-105"
            >
              <source src="/videos/futbol.mp4" type="video/mp4" />
              Tu navegador no soporta video HTML5.
            </video>

            <!-- Gradient overlay for readability and cinematic atmosphere -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 pointer-events-none"></div>

            <!-- Animated scanline accent -->
            <div class="scanline-bar"></div>

            <!-- Top HUD Badge -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-[#ccff00]/60 text-[#ccff00] text-xs font-mono font-bold uppercase tracking-wider shadow-lg flex items-center gap-1.5">
                <span class="video-indicator w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
                <span>MATCHDAY RUN // SOCCER PRO</span>
              </span>
            </div>

            <!-- Bottom Floating HUD Badge: Status -->
            <div class="absolute bottom-4 left-4 right-4 z-20 flex items-center justify-between text-xs font-mono px-4 py-2.5 rounded-xl bg-black/80 backdrop-blur-md border border-white/10 text-neutral-300">
              <span class="flex items-center gap-2 text-[#ccff00] font-bold">
                <span class="video-status-text">Reproduciendo al scroll</span>
              </span>
              <span class="text-neutral-400">APEX DRY-TECH SYSTEM</span>
            </div>
          </div>

          <!-- Micro specs tag debajo del video -->
          <div class="mt-4 grid grid-cols-3 gap-3 text-center">
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10">
              <span class="block font-athletic text-xl text-[#ccff00]">145g/m²</span>
              <span class="text-[10px] uppercase font-mono text-neutral-400">Peso Ultraligero</span>
            </div>
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10">
              <span class="block font-athletic text-xl text-white">205°C</span>
              <span class="text-[10px] uppercase font-mono text-neutral-400">Termofusión</span>
            </div>
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10">
              <span class="block font-athletic text-xl text-[#ccff00]">UV+50</span>
              <span class="text-[10px] uppercase font-mono text-neutral-400">Protección Solar</span>
            </div>
          </div>
        </div>

        <!-- COLUMNA DERECHA: DESGLOSE DETALLADO DE QUÉ SE ENTREGA, TELA Y TECNOLOGÍA -->
        <div class="lg:col-span-6 flex flex-col gap-6">

          <!-- Card 1: ¿Qué se entrega exactamente con el uniforme? -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-[#ccff00]/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#ccff00] uppercase tracking-wider">
                <span>📦 CONTENIDO DEL PAQUETE</span>
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded bg-[#ccff00]/10 text-[#ccff00] border border-[#ccff00]/30">3 Piezas Pro</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-4">
              ¿Qué Se Entrega a Cada Jugador?
            </h3>

            <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-300">
              <li class="flex items-start gap-3">
                <span class="text-[#ccff00] font-bold text-base mt-0.5">01</span>
                <div>
                  <strong class="text-white">Jersey Oficial de Juego:</strong> Sublimación 100% full-print HD en torso, espalda y mangas. Escudo del club a 300 DPI, patrocinadores ilimitados, nombre y número oficial sin costo adicional.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#ccff00] font-bold text-base mt-0.5">02</span>
                <div>
                  <strong class="text-white">Short Ergonómico con Tiro Libre:</strong> Corte anatómico por encima de la rodilla con elástico reforzado de 4cm, jareta interna de ajuste y número sublimado a juego con la playera.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#ccff00] font-bold text-base mt-0.5">03</span>
                <div>
                  <strong class="text-white">Calcetas Profesionales con Soporte de Arco:</strong> Tejido elastano tubular con compresión en empeine y tobillo, talón reforzado y amortiguación plantar antideslizante.
                </div>
              </li>
            </ul>
          </div>

          <!-- Card 2: Tipo de Tela e Ingeniería Textil -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-[#ccff00]/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#ccff00] uppercase tracking-wider mb-3">
              <span>🧵 MATERIA PRIMA & TEJIDO</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-3">
              Tipo de Tela: Dry-Tech Pro 100% Poliéster
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-4">
              Tejido de microfibra de filamento continuo de 145 gramos. Su estructura trenzada en nido de abeja facilita el flujo de aire y evita que la prenda se pegue a la piel por la acumulación de sudor durante el partido.
            </p>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-black/40 border border-white/5">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase">Ventilación</span>
                <span class="text-white font-bold">Paneles Laterales de Malla</span>
              </div>
              <div class="p-3 rounded-xl bg-black/40 border border-white/5">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase">Elasticidad</span>
                <span class="text-white font-bold">Resistencia al Tirón y Rebote</span>
              </div>
            </div>
          </div>

          <!-- Card 3: Tecnologías Usadas & Confección -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-[#ccff00]/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#ccff00] uppercase tracking-wider mb-3">
              <span>⚡ TECNOLOGÍAS APLICADAS</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-4">
              Tecnología de Fabricación
            </h3>

            <div class="space-y-3 text-xs sm:text-sm text-neutral-300">
              <div class="border-l-2 border-[#ccff00] pl-3 py-0.5">
                <strong class="text-white">Sublimación Molecular 205°C:</strong> Tintas fluorescentes italianas Ultra-Chrome que se fusionan con el hilo de poliéster. Cero deslavado, cero descascaramiento y transpiración 100% libre de parches plásticos.
              </div>
              <div class="border-l-2 border-white/40 pl-3 py-0.5">
                <strong class="text-white">Costura Plana Flatlock Antiroce:</strong> Uniones estructurales cosidas a 4 y 5 hilos de alta tenacidad que eliminan la fricción en axilas, hombros y entrepierna.
              </div>
              <div class="border-l-2 border-[#ccff00] pl-3 py-0.5">
                <strong class="text-white">Transporte Capilar del Sudor:</strong> Sistema hidrófilo interior que absorbe la humedad corporal y la expulsa a la cara externa en 0.4 segundos.
              </div>
            </div>

            <!-- Botón WhatsApp para Cotizar Fútbol -->
            <a 
              href="https://wa.me/520000000000?text=Hola%20APEX%20PRO%2C%20quiero%20cotizar%20uniformes%20de%20F%C3%BAtbol%20Soccer%20completos"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 w-full inline-flex items-center justify-center gap-2.5 bg-[#ccff00] text-black font-athletic text-sm uppercase tracking-wider py-3.5 px-6 rounded-2xl font-black hover:bg-white transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(204,255,0,0.5)] active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.42 1.01 2.59c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.14.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/></svg>
              <span>Cotizar Equipación de Fútbol</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================================= -->
    <!-- SECCIÓN 2: FÚTBOL AMERICANO (VIDEO + DESGLOSE) -->
    <!-- ============================================= -->
    <section id="americano-showcase" class="py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-24 border-t border-white/10 relative">
      <div class="parallax-element absolute bottom-1/4 -right-32 w-96 h-96 bg-cyan-500/5 rounded-full blur-[150px] pointer-events-none" data-parallax-y="-0.15"></div>

      <!-- Header de Disciplina -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 mb-2">
            <span>DISCIPLINA // 02</span>
            <span>•</span>
            <span>MÁXIMO CONTACTO & COLISIÓN</span>
          </div>
          <h2 class="font-athletic text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white">
            Equipación Pro <span class="text-cyan-400">// Fútbol Americano</span>
          </h2>
        </div>
        <div class="text-neutral-400 text-xs sm:text-sm font-mono flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-xl backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>Video Autoplay con Scroll Activo</span>
        </div>
      </div>

      <!-- Grid Principal: Video Scroll + Fichas Técnicas (Invertido en Desktop para dinamismo) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative z-10">
        
        <!-- COLUMNA IZQUIERDA: DESGLOSE DETALLADO -->
        <div class="lg:col-span-6 order-2 lg:order-1 flex flex-col gap-6">

          <!-- Card 1: ¿Qué se entrega exactamente con el uniforme? -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-cyan-400/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
                <span>📦 CONTENIDO DEL PAQUETE</span>
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded bg-cyan-400/10 text-cyan-300 border border-cyan-400/30">Kit Armor Contact</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-4">
              ¿Qué Se Entrega a Cada Jugador?
            </h3>

            <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-300">
              <li class="flex items-start gap-3">
                <span class="text-cyan-400 font-bold text-base mt-0.5">01</span>
                <div>
                  <strong class="text-white">Armor Game Jersey Ceñido:</strong> Diseñado con hombreras anatómicas y cuello en V reforzado. Ajuste ceñido sobre corazas con costura cuádruple en hombros para impedir el agarre de rivales.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-cyan-400 font-bold text-base mt-0.5">02</span>
                <div>
                  <strong class="text-white">Funda / Pantalón de Compresión:</strong> Fabricado con compartimentos ergonómicos integrados para tablas de muslo, rodilleras y coxis. Cintura elástica pesada antideslizante.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-cyan-400 font-bold text-base mt-0.5">03</span>
                <div>
                  <strong class="text-white">Dorsales & Tipografía de Impacto:</strong> Números gigantes de 25cm en pecho y 30cm en espalda con contornos dobles sublimados en alta tenacidad indeleble.
                </div>
              </li>
            </ul>
          </div>

          <!-- Card 2: Tipo de Tela e Ingeniería de Combate -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-cyan-400/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider mb-3">
              <span>🧵 MATERIA PRIMA & TEJIDO PESADO</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-3">
              Tipo de Tela: Malla Elástica Heavy 400g / Spandex 4-Way
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-4">
              Construcción híbrida con cuerpo en tela pesada resistente a rasgaduras y paneles laterales en malla Spandex 4-Way de 400 gramos. Soporta jalones violentos de tacleada de hasta 65 kg de fuerza sin romperse.
            </p>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-black/40 border border-white/5">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase">Resistencia</span>
                <span class="text-white font-bold">Grado Colisión Pesado</span>
              </div>
              <div class="p-3 rounded-xl bg-black/40 border border-white/5">
                <span class="text-neutral-400 block font-mono text-[10px] uppercase">Ajuste</span>
                <span class="text-white font-bold">Compresión Ergonómica</span>
              </div>
            </div>
          </div>

          <!-- Card 3: Tecnologías Usadas & Confección -->
          <div class="p-6 sm:p-7 rounded-3xl bg-[#0e0e14]/90 backdrop-blur-xl border border-white/10 hover:border-cyan-400/60 transition-all duration-300 shadow-xl" data-tilt>
            <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider mb-3">
              <span>⚡ TECNOLOGÍAS APLICADAS</span>
            </div>

            <h3 class="font-athletic text-2xl sm:text-3xl uppercase font-black text-white mb-4">
              Tecnología de Fabricación
            </h3>

            <div class="space-y-3 text-xs sm:text-sm text-neutral-300">
              <div class="border-l-2 border-cyan-400 pl-3 py-0.5">
                <strong class="text-white">Hilatura de Filamento Continuo Militar:</strong> Costuras reforzadas de hilo poliéster de máxima tenacidad que no revientan con el impacto directo.
              </div>
              <div class="border-l-2 border-white/40 pl-3 py-0.5">
                <strong class="text-white">Calandra Térmica a 205°C:</strong> Números, nombres y patrocinadores fusionados a nivel molecular. Olvídate de parches despegados o cuarteados.
              </div>
              <div class="border-l-2 border-cyan-400 pl-3 py-0.5">
                <strong class="text-white">Corte Asistido por Computadora CAD:</strong> Molde específico para hombrera estándar, de liniero o de receptor con ajuste ceñido antideslizante.
              </div>
            </div>

            <!-- Botón WhatsApp para Cotizar Americano -->
            <a 
              href="https://wa.me/520000000000?text=Hola%20APEX%20PRO%2C%20quiero%20cotizar%20uniformes%20de%20F%C3%BAtbol%20Americano%20completos"
              target="_blank"
              rel="noopener noreferrer"
