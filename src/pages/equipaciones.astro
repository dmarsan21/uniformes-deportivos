  <!-- Script inteligente: IntersectionObserver para reproducir en automático los videos con el Scroll -->
  <script is:inline>
    (function initScrollVideoAutoplay() {
      const videos = document.querySelectorAll('video[data-scroll-video]');
      if (!videos.length) return;

      if ('IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const video = entry.target;
            const container = video.closest('.group');
            const statusText = container ? container.querySelector('.video-status-text') : null;
            const indicator = container ? container.querySelector('.video-indicator') : null;

            if (entry.isIntersecting && entry.intersectionRatio >= 0.25) {
              // Visible en pantalla: reproducir suavemente
              const playPromise = video.play();
              if (playPromise !== undefined) {
                playPromise.then(() => {
                  if (statusText) statusText.textContent = 'En vivo // Scroll activo';
                  if (indicator) indicator.classList.add('animate-pulse');
                }).catch(() => {
                  // Fallback si el navegador bloquea autoplay
                  video.muted = true;
                  video.play();
                });
              }
            } else {
              // Fuera de pantalla: pausar para ahorrar batería y recursos
              video.pause();
              if (statusText) statusText.textContent = 'Pausado (Fuera de vista)';
              if (indicator) indicator.classList.remove('animate-pulse');
            }
          });
        }, {
          threshold: [0, 0.25, 0.5, 0.8]
        });

        videos.forEach((v) => videoObserver.observe(v));
      } else {
        // Fallback básico
        videos.forEach((v) => {
          v.play().catch(() => {});
        });
      }
    })();
  </script>
